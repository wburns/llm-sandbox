#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/common-sandbox.sh"

handle_maintenance_flags "$1"

# Gemini-specific paths
GEMINI_CONFIG_DIR="$HOME/.gemini"
GEMINI_RULES_DIR="$GEMINI_CONFIG_DIR/rules"

mkdir -p "$GEMINI_CONFIG_DIR"

# Initialize worktree environment with prefix 'gemini'
init_worktree_environment "gemini"

# Seed the session home (/root) with copies of the host config. The agent works
# on the copies; the host's ~/.gemini is never mounted. The skills shipped with
# llm-sandbox go in first; the host's own (if any) are layered on top.
seed_shipped skills "$SANDBOX_HOME/.gemini/skills"
seed_from_host "$GEMINI_CONFIG_DIR" "$SANDBOX_HOME/.gemini" \
    settings.json .env skills policies GEMINI.md

# Rules (shipped, then the host's, which win on a name clash) are compiled into
# the session's GEMINI.md, replacing the copied one.
compile_rules "$SANDBOX_HOME/.gemini/GEMINI.md" "$SHIPPED_RULES_DIR" "$GEMINI_RULES_DIR"

# The workspace is a throwaway worktree inside the container, so always trust it
# (the session home has no trustedFolders.json, which would otherwise leave it untrusted).
TOOL_PODMAN_ARGS=(
    -e CLI_TOOL_NAME="gemini"
    -e GEMINI_CLI_TRUST_WORKSPACE="true"
)

# Auth is the GEMINI_API_KEY environment variable, forwarded on every launch.
if [ -n "$GEMINI_API_KEY" ]; then
    TOOL_PODMAN_ARGS+=(-e GEMINI_API_KEY)  # by name, so the key isn't on the command line
fi

# SANDBOX_NON_INTERACTIVE=1 (set by review-pr --non-interactive) runs the prompt
# headless: gemini -p prints the answer and exits.
GEMINI_CMD=(gemini --approval-mode=yolo)
if [ "${SANDBOX_NON_INTERACTIVE:-}" = 1 ]; then
    GEMINI_CMD+=(-p)
fi

# Run the container (pass any CLI command arguments)
run_agent_container "gemini-dev-sandbox:latest" \
    "${TOOL_PODMAN_ARGS[@]}" \
    -- "${GEMINI_CMD[@]}" "$@"
