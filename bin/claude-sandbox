#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/common-sandbox.sh"

handle_maintenance_flags "$1"

# --- Claude-Specific Paths ---
SHARED_GCLOUD_DIR="$BASE_SANDBOX_DIR/shared_gcloud"
CLAUDE_CONFIG_DIR="$HOME/.claude"
CLAUDE_RULES_DIR="$CLAUDE_CONFIG_DIR/rules"

# Initialize worktree environment with prefix 'claude'
init_worktree_environment "claude"

# Seed the session home (/root) with copies of the host config. The agent works
# on the copies; the host's ~/.claude is never mounted. The skills shipped with
# llm-sandbox go in first; the host's own (if any) are layered on top.
seed_shipped skills "$SANDBOX_HOME/.claude/skills"
seed_from_host "$CLAUDE_CONFIG_DIR" "$SANDBOX_HOME/.claude" settings.json skills CLAUDE.md
seed_from_host "$HOME" "$SANDBOX_HOME" .claude.json

# Rules (shipped, then the host's, which win on a name clash) are compiled into
# the session's CLAUDE.md, replacing the copied one.
compile_rules "$SANDBOX_HOME/.claude/CLAUDE.md" "$SHIPPED_RULES_DIR" "$CLAUDE_RULES_DIR"

# --- Build Tool-Specific Container Options ---
TOOL_PODMAN_ARGS=(
    -e IS_SANDBOX=1
    -e CLI_TOOL_NAME="claude"
    -w /workspace
)

# --- Authentication ---
# 1. CLAUDE_VERTEX_PROJECT_ID set: Vertex AI via gcloud ADC. The shared gcloud
#    cache below persists the login between runs (see share/claude-setup).
# 2. Otherwise ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN set: the Anthropic API,
#    or a gateway when ANTHROPIC_BASE_URL is set. Every ANTHROPIC_* variable in
#    the host environment (key/token, base URL, model choices, ...) is forwarded
#    by name, so values never appear on the container command line.
if [ -n "${CLAUDE_VERTEX_PROJECT_ID:-}" ]; then
    mkdir -p "$SHARED_GCLOUD_DIR"
    TOOL_PODMAN_ARGS+=(-v "$SHARED_GCLOUD_DIR":/root/.config/gcloud:z)
    echo "☁️ Shared gcloud auth cache: $SHARED_GCLOUD_DIR -> /root/.config/gcloud"
elif [ -n "${ANTHROPIC_API_KEY:-}" ] || [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
    ANTHROPIC_VARS=()
    while IFS= read -r var; do
        ANTHROPIC_VARS+=("$var")
        TOOL_PODMAN_ARGS+=(-e "$var")
    done < <(compgen -e | grep '^ANTHROPIC_' | sort)
    echo "🔑 Anthropic API auth: forwarding ${ANTHROPIC_VARS[*]}"
else
    echo "⚠️ No Claude credentials: set CLAUDE_VERTEX_PROJECT_ID (Vertex AI) or ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN."
    echo "   Claude will ask you to log in, and that login is not kept after the session."
fi

# Mount the installed claude-setup read-only. Only the copy shipped with
# llm-sandbox is used, never one found in the project being worked on.
CLAUDE_SETUP_PATH="$(cd "$SCRIPT_DIR/../share" && pwd)/claude-setup"
if [ ! -f "$CLAUDE_SETUP_PATH" ]; then
    echo "ERROR: $CLAUDE_SETUP_PATH not found; reinstall llm-sandbox." >&2
    exit 1
fi
TOOL_PODMAN_ARGS+=(-v "$CLAUDE_SETUP_PATH":/usr/local/bin/claude-setup:ro,z)

# Vertex project used by claude-setup (optional). Set CLAUDE_VERTEX_PROJECT_ID to enable.
if [ -n "$CLAUDE_VERTEX_PROJECT_ID" ]; then
    TOOL_PODMAN_ARGS+=(-e CLAUDE_VERTEX_PROJECT_ID="$CLAUDE_VERTEX_PROJECT_ID")
fi

echo "⚙️ Session home with copied config: $SANDBOX_HOME -> /root"

# SANDBOX_NON_INTERACTIVE=1 (set by review-pr --non-interactive) runs the prompt
# headless: print the answer and exit.
CLAUDE_FLAGS=(--dangerously-skip-permissions)
[ "${SANDBOX_NON_INTERACTIVE:-}" = 1 ] && CLAUDE_FLAGS+=(-p)

# Run container via common-sandbox.sh
# Everything after '--' is executed as the container command inside the sandbox
run_agent_container "claude-dev-sandbox:latest" \
    "${TOOL_PODMAN_ARGS[@]}" \
    -- bash -c '
        if [ -n "$CLAUDE_VERTEX_PROJECT_ID" ]; then
            echo "⚙️ Running Vertex AI setup..."
            source /usr/local/bin/claude-setup "$CLAUDE_VERTEX_PROJECT_ID" || exit 1
        fi
        exec claude "$@"
    ' -- "${CLAUDE_FLAGS[@]}" "$@"
