#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/common-sandbox.sh"

handle_maintenance_flags "$1"

# Interactive sessions skip tool-approval prompts, like the Claude and Gemini
# launchers (the container is the sandbox). --auto-approve is ignored in an
# untrusted folder and every session worktree is new, so also pass --trust (the
# trust record only lives in the throwaway session home).
#
# bob rejects bare positional arguments, and `-p`/`run` are headless (they need
# BOB_API_KEY, not the saved login). So words that aren't a flag or a bob
# subcommand are taken as an initial prompt: bob-prompt starts `bob chat` on a
# pty and types the prompt into it once the UI is ready.
#
# SANDBOX_NON_INTERACTIVE=1 (set by review-pr --non-interactive) is the exception:
# the prompt runs headless as `bob run`, which needs BOB_API_KEY.
INITIAL_PROMPT=""
case "${1:-}" in
    "")   set -- chat --auto-approve --trust ;;
    chat) shift; set -- chat --auto-approve --trust "$@" ;;
    -*|run|mcp|acp) ;;
    *)
        if [ "${SANDBOX_NON_INTERACTIVE:-}" = 1 ]; then
            if [ -z "${BOB_API_KEY:-}" ]; then
                echo "ERROR: a non-interactive Bob run (bob run) needs BOB_API_KEY set; the saved login is not used." >&2
                exit 1
            fi
            set -- run --trust "$*"
        else
            INITIAL_PROMPT="$*"; set -- chat --auto-approve --trust
        fi
        ;;
esac

# Bob-specific paths
BOB_SETTINGS_DIR="$HOME/.bob/settings"
BOB_CONFIG_DIR="$HOME/.bob"

# Initialize worktree environment with prefix 'bob'
init_worktree_environment "bob"

# Seed the session home (/root) with copies of the host config. The agent works
# on the copies; the host's ~/.bob is never mounted. The rules/skills shipped
# with llm-sandbox go in first; the host's own (if any) are layered on top.
seed_shipped rules "$SANDBOX_HOME/.bob/rules"
seed_shipped skills "$SANDBOX_HOME/.bob/skills"
seed_from_host "$BOB_CONFIG_DIR" "$SANDBOX_HOME/.bob" rules skills
seed_from_host "$BOB_SETTINGS_DIR" "$SANDBOX_HOME/.bob/settings" settings.json
# The API key/token file is synced back to the host on exit, so a login (or token
# refresh) made in the sandbox persists between runs. It may not exist yet.
seed_auth_from_host "$BOB_SETTINGS_DIR" "$SANDBOX_HOME/.bob/settings" auth-secrets.json
if [ ! -f "$BOB_SETTINGS_DIR/auth-secrets.json" ]; then
    echo "ℹ️ No $BOB_SETTINGS_DIR/auth-secrets.json yet; log in inside the sandbox and it will be saved when you exit."
fi

# Define tool-specific mounts and environment variables
TOOL_PODMAN_ARGS=(
    -e CLI_TOOL_NAME="bob"
)

# API key auth (needed for `bob run`). Forwarded by name, so the key isn't on the
# command line.
if [ -n "${BOB_API_KEY:-}" ]; then
    TOOL_PODMAN_ARGS+=(-e BOB_API_KEY)
fi

BOB_CMD=(bob "$@")
if [ -n "$INITIAL_PROMPT" ]; then
    # Mount the installed bob-prompt read-only (only the copy shipped with
    # llm-sandbox is used, never one found in the project being worked on).
    BOB_PROMPT_PATH="$(cd "$SCRIPT_DIR/../share" && pwd)/bob-prompt"
    if [ ! -f "$BOB_PROMPT_PATH" ]; then
        echo "ERROR: $BOB_PROMPT_PATH not found; reinstall llm-sandbox." >&2
        exit 1
    fi
    TOOL_PODMAN_ARGS+=(
        -v "$BOB_PROMPT_PATH":/usr/local/bin/bob-prompt:ro,z
        -e BOB_INITIAL_PROMPT="$INITIAL_PROMPT"
    )
    BOB_CMD=(bob-prompt bob "$@")
fi

# Run the container
run_agent_container "bob-dev-sandbox:latest" "${TOOL_PODMAN_ARGS[@]}" -- "${BOB_CMD[@]}"
