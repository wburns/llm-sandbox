#!/usr/bin/env bash
# sandbox-session - Move a sandbox session to another machine as a zip file.
#
# Usage:
#   sandbox-session pack [-a] [-f] [-o <file.zip>] [<session-id>]
#   sandbox-session unpack [-f] <file.zip>
#
# pack:    Picks a session (fzf, like sandbox-resume; or give a session ID/prefix)
#          and writes only its conversation history (plus .session-info and the Logseq
#          run logs) to a zip file (default: ./<session-id>.zip). Nothing else from the
#          session home is copied: no settings, credentials, caches or shell history.
#          The history can still contain secrets the agent saw: keep the archive private.
#   unpack:  Restores the session from a zip file into this machine's session store and
#          re-seeds rules, skills and settings from this machine, like a fresh launch.
#          Then run sandbox-resume from inside your checkout of the repository.
#
# Options:
#   -a, --all        (pack) Show sessions across all repositories
#   -o <file.zip>    (pack) Output file
#   -f, --force      Overwrite an existing output file / existing session
#   -h, --help       Show this help message
set -e

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
source "$SCRIPT_DIR/common-sandbox.sh"

SESSIONS_DIR="$BASE_SANDBOX_DIR/sessions"

usage() {
    sed -n '2,21p' "$SCRIPT_PATH" | sed 's/^# \{0,1\}//'
}

info_field() { # <session-dir> <KEY>
    sed -n "s/^$2=//p" "$1/.session-info" 2>/dev/null | head -n 1
}

# pick_session <session-arg> <show-all>  -> sets SELECTED_SESSION
pick_session() {
    local arg="$1" show_all="$2"
    if [ ! -d "$SESSIONS_DIR" ]; then
        echo "ERROR: No saved sessions found in $SESSIONS_DIR." >&2
        exit 1
    fi

    local current_repo=""
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        current_repo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    fi

    # Columns: epoch, sname, agent, repo_name, base_branch, updated_at, repo_dir
    local raw=() sdir sname agent repo_dir repo_name base_branch updated_at epoch
    for sdir in "$SESSIONS_DIR"/*; do
        [ -d "$sdir" ] || continue
        sname="$(basename "$sdir")"
        agent="$(info_field "$sdir" AGENT)"
        repo_dir="$(info_field "$sdir" REPO_DIR)"
        repo_name="$(info_field "$sdir" REPO_NAME)"
        base_branch="$(info_field "$sdir" BASE_BRANCH)"
        updated_at="$(info_field "$sdir" UPDATED_AT)"
        [ -n "$agent" ] || agent="${sname%%_*}"
        [ -n "$repo_name" ] || repo_name="unknown"
        [ -n "$base_branch" ] || base_branch="-"
        [ -n "$updated_at" ] || updated_at="$(date -r "$sdir" +'%Y-%m-%d %H:%M:%S' 2>/dev/null || date +'%Y-%m-%d %H:%M:%S')"
        epoch="$(date -d "$updated_at" +%s 2>/dev/null || stat -c %Y "$sdir" 2>/dev/null || echo 0)"
        raw+=("$epoch"$'\t'"$sname"$'\t'"$agent"$'\t'"$repo_name"$'\t'"$base_branch"$'\t'"$updated_at"$'\t'"$repo_dir")
    done
    if [ "${#raw[@]}" -eq 0 ]; then
        echo "ERROR: No saved sessions found in $SESSIONS_DIR." >&2
        exit 1
    fi

    local filtered=() item
    if [ "$show_all" = false ] && [ -n "$current_repo" ] && [ -z "$arg" ]; then
        for item in "${raw[@]}"; do
            [ "$(printf '%s' "$item" | cut -f7)" = "$current_repo" ] && filtered+=("$item")
        done
        if [ "${#filtered[@]}" -eq 0 ]; then
            echo "ℹ️ No sessions found for current repo ($(basename "$current_repo")). Showing all sessions across repositories."
            filtered=("${raw[@]}")
        fi
    else
        filtered=("${raw[@]}")
    fi

    local sorted=() line
    while IFS= read -r line; do
        [ -n "$line" ] && sorted+=("$line")
    done < <(printf '%s\n' "${filtered[@]}" | sort -t$'\t' -k1,1rn)

    SELECTED_SESSION=""
    if [ -n "$arg" ]; then
        for line in "${sorted[@]}"; do
            sname="$(printf '%s' "$line" | cut -f2)"
            if [[ "$sname" == "$arg"* ]]; then
                SELECTED_SESSION="$sname"
                break
            fi
        done
        if [ -z "$SELECTED_SESSION" ]; then
            echo "ERROR: No saved session matching '$arg' found." >&2
            exit 1
        fi
    elif [ "${#sorted[@]}" -eq 1 ]; then
        SELECTED_SESSION="$(printf '%s' "${sorted[0]}" | cut -f2)"
    elif command -v fzf >/dev/null 2>&1; then
        local fzf_input="" choice
        for line in "${sorted[@]}"; do
            fzf_input+="$(printf '%s' "$line" | cut -f2-6)"$'\n'
        done
        choice="$(printf '%s' "$fzf_input" | fzf --no-sort --delimiter=$'\t' --with-nth=2,3,4,5 \
            --prompt="sandbox-session> " \
            --header=$'AGENT\tREPOSITORY\tBRANCH\tLAST OPERATED' \
            --preview="\"$SCRIPT_DIR/sandbox-resume\" --preview {1}" \
            --bind='ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' \
            --preview-window="right:55%:wrap")" || exit 1
        SELECTED_SESSION="${choice%%$'\t'*}"
    else
        echo "Saved sessions (install fzf for interactive search and preview):"
        local options=() keys=() opt
        for line in "${sorted[@]}"; do
            options+=("[$(printf '%s' "$line" | cut -f6)] $(printf '%s' "$line" | cut -f3) - $(printf '%s' "$line" | cut -f4) ($(printf '%s' "$line" | cut -f5)) [$(printf '%s' "$line" | cut -f2)]")
            keys+=("$(printf '%s' "$line" | cut -f2)")
        done
        PS3="Select a session to pack: "
        select opt in "${options[@]}"; do
            if [ -n "$opt" ]; then
                SELECTED_SESSION="${keys[$((REPLY - 1))]}"
                break
            fi
        done
    fi
    : "${SELECTED_SESSION:?ERROR: No session selected.}"
}

do_pack() {
    local show_all=false force=false out="" session_arg=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -a|--all) show_all=true; shift ;;
            -f|--force) force=true; shift ;;
            -o)
                if [ -z "${2:-}" ]; then
                    echo "ERROR: -o requires a file name." >&2
                    exit 1
                fi
                out="$2"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) echo "ERROR: Unknown option '$1'." >&2; exit 1 ;;
            *) session_arg="$1"; shift ;;
        esac
    done
    command -v zip >/dev/null 2>&1 || { echo "ERROR: 'zip' is required." >&2; exit 1; }

    pick_session "$session_arg" "$show_all"
    local sname="$SELECTED_SESSION"
    local sdir="$SESSIONS_DIR/$sname"
    local ldir="$LOGSEQ_LOG_DIR/$sname"

    [ -n "$out" ] || out="$sname.zip"
    out="$(readlink -m "$out")"
    if [ -e "$out" ] && [ "$force" = false ]; then
        echo "ERROR: $out already exists (use -f to overwrite)." >&2
        exit 1
    fi
    rm -f "$out"

    local status
    status="$(info_field "$sdir" STATUS)"
    if [ -n "$status" ] && [ "$status" != "closed" ]; then
        echo "⚠️ Session status is '$status'; it may still be running or was not closed cleanly."
    fi

    # Conversation history only, per agent (an allowlist, so new files an agent
    # starts writing to its config directory are never picked up by accident).
    local agent
    agent="$(info_field "$sdir" AGENT)"
    [ -n "$agent" ] || agent="${sname%%_*}"
    local history=()
    case "$agent" in
        bob)    history=(.bob/db) ;;
        claude) history=(.claude/projects .claude/history.jsonl) ;;
        gemini) history=(.gemini/tmp .gemini/history .gemini/projects.json) ;;
        codex)  history=(.codex/sessions .codex/history.jsonl) ;;
        *)
            echo "ERROR: Unknown agent '$agent'." >&2
            exit 1
            ;;
    esac
    local paths=("$sname/session/.session-info") p found=false
    for p in "${history[@]}"; do
        if [ -e "$sdir/$p" ]; then
            paths+=("$sname/session/$p")
            found=true
        fi
    done
    if [ "$found" = false ]; then
        echo "ERROR: No $agent conversation history found in $sdir." >&2
        exit 1
    fi
    [ -d "$ldir" ] && paths+=("$sname/logs")

    # Stage the session and its logs under one top-level directory <sname>/ so
    # a single zip can carry both (they live in different directories).
    local stage
    stage="$(mktemp -d)"
    trap 'rm -rf "$stage"' EXIT
    mkdir "$stage/$sname"
    ln -s "$sdir" "$stage/$sname/session"
    [ -d "$ldir" ] && ln -s "$ldir" "$stage/$sname/logs"

    echo "📦 Packing session '$sname'..."
    (cd "$stage" && zip -qr "$out" "${paths[@]}")

    echo "✅ Wrote $out ($(du -h "$out" | cut -f1))"
    echo "⚠️ Only conversation history is included, but it may contain secrets the agent saw or"
    echo "   printed. Keep the archive private."
    echo "   On the other machine: sandbox-session unpack $(basename "$out")"
}

# seed_session_config <session-home> <agent>
# The archive holds only conversation history, so give the restored session the
# same rules, skills and settings a fresh launch would (this mirrors what
# bob-sandbox / claude-sandbox / gemini-sandbox / codex-sandbox seed). sandbox-resume does not
# seed anything itself. Bob's login is seeded by sandbox-resume from the host.
seed_session_config() {
    local home="$1" agent="$2"
    case "$agent" in
        bob)
            seed_shipped rules "$home/.bob/rules"
            seed_shipped skills "$home/.bob/skills"
            seed_from_host "$HOME/.bob" "$home/.bob" rules skills
            seed_from_host "$HOME/.bob/settings" "$home/.bob/settings" settings.json
            ;;
        claude)
            seed_shipped skills "$home/.claude/skills"
            seed_from_host "$HOME/.claude" "$home/.claude" settings.json skills CLAUDE.md
            seed_from_host "$HOME" "$home" .claude.json
            compile_rules "$home/.claude/CLAUDE.md" "$SHIPPED_RULES_DIR" "$HOME/.claude/rules"
            ;;
        gemini)
            seed_shipped skills "$home/.gemini/skills"
            seed_from_host "$HOME/.gemini" "$home/.gemini" settings.json .env skills policies GEMINI.md
            compile_rules "$home/.gemini/GEMINI.md" "$SHIPPED_RULES_DIR" "$HOME/.gemini/rules"
            ;;
        codex)
            seed_shipped skills "$home/.agents/skills"
            seed_from_host "$HOME/.agents" "$home/.agents" skills
            seed_from_host "$HOME/.codex" "$home/.codex" config.toml AGENTS.md
            compile_rules "$home/.codex/AGENTS.md" "$SHIPPED_RULES_DIR" "$HOME/.codex/rules"
            ;;
        *)
            echo "ERROR: Unknown agent '$agent'." >&2
            exit 1
            ;;
    esac
}

do_unpack() {
    local force=false file=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -f|--force) force=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) echo "ERROR: Unknown option '$1'." >&2; exit 1 ;;
            *) file="$1"; shift ;;
        esac
    done
    command -v unzip >/dev/null 2>&1 || { echo "ERROR: 'unzip' is required." >&2; exit 1; }
    if [ -z "$file" ]; then
        echo "ERROR: unpack requires a zip file." >&2
        usage >&2
        exit 1
    fi
    if [ ! -f "$file" ]; then
        echo "ERROR: $file not found." >&2
        exit 1
    fi

    local tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    unzip -q "$file" -d "$tmp"

    if [ -n "$(find "$tmp" -type l -print -quit)" ]; then
        echo "ERROR: $file contains symbolic links; refusing to unpack." >&2
        exit 1
    fi

    local top=("$tmp"/*)
    if [ "${#top[@]}" -ne 1 ] || [ ! -f "${top[0]}/session/.session-info" ]; then
        echo "ERROR: $file is not a sandbox-session archive." >&2
        exit 1
    fi
    local sname
    sname="$(basename "${top[0]}")"
    if [[ ! "$sname" =~ ^[A-Za-z0-9_.-]+$ ]] || [ "$sname" = "." ] || [ "$sname" = ".." ]; then
        echo "ERROR: Invalid session name '$sname' in archive." >&2
        exit 1
    fi

    local dest="$SESSIONS_DIR/$sname"
    if [ -e "$dest" ]; then
        if [ "$force" = false ]; then
            echo "ERROR: Session '$sname' already exists in $SESSIONS_DIR (use -f to replace it)." >&2
            exit 1
        fi
        rm -rf "$dest"
    fi
    mkdir -p "$SESSIONS_DIR"
    mv "${top[0]}/session" "$dest"

    if [ -d "${top[0]}/logs" ]; then
        mkdir -p "$LOGSEQ_LOG_DIR/$sname"
        cp -a "${top[0]}/logs/." "$LOGSEQ_LOG_DIR/$sname/"
    fi

    local agent repo_name
    agent="$(info_field "$dest" AGENT)"
    [ -n "$agent" ] || agent="${sname%%_*}"
    seed_session_config "$dest" "$agent"
    repo_name="$(info_field "$dest" REPO_NAME)"
    echo "✅ Restored session '$sname' to $dest"
    echo "   Check out ${repo_name:-the repository} on this machine, then run sandbox-resume from inside it."
}

case "${1:-}" in
    pack)   shift; do_pack "$@" ;;
    unpack) shift; do_unpack "$@" ;;
    -h|--help) usage ;;
    *)
        usage >&2
        exit 1
        ;;
esac
