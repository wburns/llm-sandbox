#!/usr/bin/env bash
# sandbox-resume - Resume a closed LLM sandbox session with a new on-demand worktree.
#
# Usage:
#   sandbox-resume [options] [<session-id>] [command...]
#
# Options:
#   -a, --all        Show sessions across all repositories (default if not in a git repo)
#   -b <branch>      Base branch for the new worktree (defaults to current branch)
#   -h, --help       Show this help message
#   --preview <dir>  Render session preview (internal helper used by fzf)
#
# When run without a session ID, opens an interactive fzf picker sorted by
# last operated date (most recent first) with session details in the preview window.
set -e

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
source "$SCRIPT_DIR/common-sandbox.sh"

# --- Preview Subcommand ---
render_preview() {
    local target="${1:-}"
    # Strip any leading/trailing quotes that may be passed
    target="${target#\'}"
    target="${target%\'}"
    target="${target#\"}"
    target="${target%\"}"

    local sdir="$target"
    if [ ! -d "$sdir" ] && [ -d "$BASE_SANDBOX_DIR/sessions/$target" ]; then
        sdir="$BASE_SANDBOX_DIR/sessions/$target"
    fi
    if [ ! -d "$sdir" ]; then
        echo "Session directory not found: $target"
        return 1
    fi
    local sname
    sname="$(basename "$sdir")"
    local agent="" repo_dir="" repo_name="" base_branch="" created_at="" updated_at="" prompt="" status=""
    if [ -f "$sdir/.session-info" ]; then
        agent="$(sed -n 's/^AGENT=//p' "$sdir/.session-info" | head -n 1)"
        repo_dir="$(sed -n 's/^REPO_DIR=//p' "$sdir/.session-info" | head -n 1)"
        repo_name="$(sed -n 's/^REPO_NAME=//p' "$sdir/.session-info" | head -n 1)"
        base_branch="$(sed -n 's/^BASE_BRANCH=//p' "$sdir/.session-info" | head -n 1)"
        created_at="$(sed -n 's/^CREATED_AT=//p' "$sdir/.session-info" | head -n 1)"
        updated_at="$(sed -n 's/^UPDATED_AT=//p' "$sdir/.session-info" | head -n 1)"
        prompt="$(sed -n 's/^INITIAL_PROMPT=//p' "$sdir/.session-info" | head -n 1)"
        status="$(sed -n 's/^STATUS=//p' "$sdir/.session-info" | head -n 1)"
    fi
    [ -n "$agent" ] || agent="${sname%%_*}"
    [ -n "$updated_at" ] || updated_at="$(date -r "$sdir" +'%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "Unknown")"
    [ -n "$created_at" ] || created_at="$updated_at"

    # Calculate session duration/time used
    local duration_str=""
    if [ -n "$created_at" ] && [ -n "$updated_at" ]; then
        local c_epoch u_epoch diff_s
        c_epoch="$(date -d "$created_at" +%s 2>/dev/null || echo 0)"
        u_epoch="$(date -d "$updated_at" +%s 2>/dev/null || echo 0)"
        if [ "$c_epoch" -gt 0 ] && [ "$u_epoch" -ge "$c_epoch" ]; then
            diff_s=$((u_epoch - c_epoch))
            local hrs=$((diff_s / 3600))
            local mins=$(((diff_s % 3600) / 60))
            local secs=$((diff_s % 60))
            if [ "$hrs" -gt 0 ]; then
                duration_str="${hrs}h ${mins}m ${secs}s"
            elif [ "$mins" -gt 0 ]; then
                duration_str="${mins}m ${secs}s"
            else
                duration_str="${secs}s"
            fi
        fi
    fi

    printf "═══════════════════════════════════════════════════════════════\n"
    printf "  Session ID:   %s\n" "$sname"
    printf "  Agent:        %s\n" "$agent"
    printf "  Last Active:  %s\n" "$updated_at"
    printf "  Created:      %s\n" "$created_at"
    [ -n "$duration_str" ] && printf "  Time Used:    %s\n" "$duration_str"
    [ -n "$status" ] && printf "  Status:       %s\n" "$status"
    [ -n "$repo_name" ] && printf "  Repository:   %s (%s)\n" "$repo_name" "${repo_dir:-unknown}"
    [ -n "$base_branch" ] && printf "  Base Branch:  %s\n" "$base_branch"
    [ -n "$prompt" ] && printf "  Initial Task: %s\n" "$prompt"
    printf "═══════════════════════════════════════════════════════════════\n\n"

    # Show agent session state / transcripts
    if [ "$agent" = "claude" ] && [ -d "$sdir/.claude" ]; then
        echo "📂 Claude Session State:"
        find "$sdir/.claude" -maxdepth 2 -not -path '*/.*' 2>/dev/null | head -n 15 | sed 's/^/  /'
        echo ""
    elif [ "$agent" = "bob" ] && [ -d "$sdir/.bob" ]; then
        echo "📂 Bob Session State:"
        find "$sdir/.bob" -maxdepth 2 -not -path '*/.*' 2>/dev/null | head -n 15 | sed 's/^/  /'
        echo ""
    elif [ "$agent" = "gemini" ] && [ -d "$sdir/.gemini" ]; then
        echo "📂 Gemini Session State:"
        find "$sdir/.gemini" -maxdepth 2 -not -path '*/.*' 2>/dev/null | head -n 15 | sed 's/^/  /'
        echo ""
    elif [ "$agent" = "codex" ] && [ -d "$sdir/.codex" ]; then
        echo "📂 Codex Session State:"
        find "$sdir/.codex" -maxdepth 2 -not -path '*/.*' 2>/dev/null | head -n 15 | sed 's/^/  /'
        echo ""
    fi

    # Show Logseq run logs if any exist for this session
    local logseq_dir="$LOGSEQ_LOG_DIR/$sname"
    if [ -d "$logseq_dir" ]; then
        local logs=()
        for l in "$logseq_dir"/run_*.md; do
            [ -f "$l" ] && logs+=("$l")
        done
        if [ "${#logs[@]}" -gt 0 ]; then
            echo "📝 Logseq Run Logs (${#logs[@]}):"
            for log in "${logs[@]}"; do
                echo "  • $(basename "$log")"
                sed 's/^/    /' "$log"
            done
        fi
    fi
}

if [ "${1:-}" = "--preview" ]; then
    render_preview "${2:-}"
    exit 0
fi

# --- Option Parsing ---
SHOW_ALL=false
TARGET_BRANCH=""
SESSION_ARG=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -a|--all)
            SHOW_ALL=true
            shift
            ;;
        -b)
            if [ -z "${2:-}" ]; then
                echo "ERROR: -b requires a branch name." >&2
                exit 1
            fi
            TARGET_BRANCH="$2"
            shift 2
            ;;
        -h|--help)
            sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "ERROR: Unknown option '$1'." >&2
            exit 1
            ;;
        *)
            SESSION_ARG="$1"
            shift
            break
            ;;
    esac
done

PASSED_CMD=("$@")

# --- Session Discovery & Sorting ---
SESSIONS_DIR="$BASE_SANDBOX_DIR/sessions"
if [ ! -d "$SESSIONS_DIR" ]; then
    echo "ERROR: No saved sessions found in $SESSIONS_DIR." >&2
    exit 1
fi

CURRENT_REPO=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    CURRENT_REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi

raw_sessions=()
for sdir in "$SESSIONS_DIR"/*; do
    [ -d "$sdir" ] || continue
    sname="$(basename "$sdir")"

    agent="" repo_dir="" repo_name="" base_branch="" created_at="" updated_at=""
    if [ -f "$sdir/.session-info" ]; then
        agent="$(sed -n 's/^AGENT=//p' "$sdir/.session-info" | head -n 1)"
        repo_dir="$(sed -n 's/^REPO_DIR=//p' "$sdir/.session-info" | head -n 1)"
        repo_name="$(sed -n 's/^REPO_NAME=//p' "$sdir/.session-info" | head -n 1)"
        base_branch="$(sed -n 's/^BASE_BRANCH=//p' "$sdir/.session-info" | head -n 1)"
        created_at="$(sed -n 's/^CREATED_AT=//p' "$sdir/.session-info" | head -n 1)"
        updated_at="$(sed -n 's/^UPDATED_AT=//p' "$sdir/.session-info" | head -n 1)"
    fi

    [ -n "$agent" ] || agent="${sname%%_*}"
    [ -n "$repo_name" ] || repo_name="unknown"
    [ -n "$base_branch" ] || base_branch="-"
    [ -n "$updated_at" ] || updated_at="$(date -r "$sdir" +'%Y-%m-%d %H:%M:%S' 2>/dev/null || date +'%Y-%m-%d %H:%M:%S')"

    # Epoch timestamp for numeric reverse sorting (most recent first)
    epoch="$(date -d "$updated_at" +%s 2>/dev/null || stat -c %Y "$sdir" 2>/dev/null || echo 0)"

    raw_sessions+=("$epoch"$'\t'"$sname"$'\t'"$agent"$'\t'"$repo_name"$'\t'"$base_branch"$'\t'"$updated_at"$'\t'"$repo_dir")
done

if [ "${#raw_sessions[@]}" -eq 0 ]; then
    echo "ERROR: No saved sessions found in $SESSIONS_DIR." >&2
    exit 1
fi

# Filter sessions if inside a git repository and not --all
filtered_sessions=()
if [ "$SHOW_ALL" = false ] && [ -n "$CURRENT_REPO" ]; then
    for item in "${raw_sessions[@]}"; do
        rdir="$(printf '%s' "$item" | cut -f7)"
        if [ "$rdir" = "$CURRENT_REPO" ]; then
            filtered_sessions+=("$item")
        fi
    done
    if [ "${#filtered_sessions[@]}" -eq 0 ]; then
        echo "ℹ️ No sessions found for current repo ($(basename "$CURRENT_REPO")). Showing all sessions across repositories."
        filtered_sessions=("${raw_sessions[@]}")
    fi
else
    filtered_sessions=("${raw_sessions[@]}")
fi

# Sort descending by epoch timestamp (most recent first)
sorted_sessions=()
while IFS= read -r line; do
    [ -n "$line" ] && sorted_sessions+=("$line")
done < <(printf '%s\n' "${filtered_sessions[@]}" | sort -t$'\t' -k1,1rn)

# --- Session Selection ---
SELECTED_SESSION=""

if [ -n "$SESSION_ARG" ]; then
    # Direct match (exact or prefix)
    for line in "${sorted_sessions[@]}"; do
        sname="$(printf '%s' "$line" | cut -f2)"
        if [[ "$sname" == "$SESSION_ARG"* ]] || [ "$sname" = "$SESSION_ARG" ]; then
            SELECTED_SESSION="$sname"
            break
        fi
    done
    if [ -z "$SELECTED_SESSION" ]; then
        echo "ERROR: No saved session matching '$SESSION_ARG' found." >&2
        exit 1
    fi
elif [ "${#sorted_sessions[@]}" -eq 1 ]; then
    SELECTED_SESSION="$(printf '%s' "${sorted_sessions[0]}" | cut -f2)"
elif command -v fzf >/dev/null 2>&1; then
    fzf_input=""
    for line in "${sorted_sessions[@]}"; do
        # Columns: sname \t agent \t repo_name \t base_branch \t updated_at
        fzf_input+="$(printf '%s' "$line" | cut -f2-6)"$'\n'
    done

    choice="$(printf '%s' "$fzf_input" | fzf --no-sort --delimiter=$'\t' --with-nth=2,3,4,5 \
        --prompt="sandbox-resume> " \
        --header=$'AGENT\tREPOSITORY\tBRANCH\tLAST OPERATED' \
        --preview="\"$SCRIPT_PATH\" --preview {1}" \
        --bind='ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' \
        --preview-window="right:55%:wrap")" || exit 1

    SELECTED_SESSION="${choice%%$'\t'*}"
else
    echo "Saved sessions (install fzf for interactive search and preview):"
    options=()
    session_keys=()
    for line in "${sorted_sessions[@]}"; do
        sname="$(printf '%s' "$line" | cut -f2)"
        agent="$(printf '%s' "$line" | cut -f3)"
        rname="$(printf '%s' "$line" | cut -f4)"
        bbranch="$(printf '%s' "$line" | cut -f5)"
        opdate="$(printf '%s' "$line" | cut -f6)"
        options+=("[$opdate] $agent - $rname ($bbranch) [$sname]")
        session_keys+=("$sname")
    done
    PS3="Select a session to resume: "
    select opt in "${options[@]}"; do
        if [ -n "$opt" ]; then
            idx=$((REPLY - 1))
            SELECTED_SESSION="${session_keys[$idx]}"
            break
        fi
    done
fi

: "${SELECTED_SESSION:?ERROR: No session selected.}"

SESSION_HOME="$SESSIONS_DIR/$SELECTED_SESSION"
if [ ! -d "$SESSION_HOME" ]; then
    echo "ERROR: Session directory $SESSION_HOME does not exist." >&2
    exit 1
fi

# Read target agent and repo from session metadata
AGENT=""
REPO_DIR=""
BASE_BRANCH=""
if [ -f "$SESSION_HOME/.session-info" ]; then
    AGENT="$(sed -n 's/^AGENT=//p' "$SESSION_HOME/.session-info" | head -n 1)"
    REPO_DIR="$(sed -n 's/^REPO_DIR=//p' "$SESSION_HOME/.session-info" | head -n 1)"
    BASE_BRANCH="$(sed -n 's/^BASE_BRANCH=//p' "$SESSION_HOME/.session-info" | head -n 1)"
fi
[ -n "$AGENT" ] || AGENT="${SELECTED_SESSION%%_*}"

# Navigate to target git repository
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    top_dir="$(git rev-parse --show-toplevel)"
    if [ -n "$REPO_DIR" ] && [ "$top_dir" != "$REPO_DIR" ] && [ -d "$REPO_DIR" ]; then
        echo "📂 Switching to session repository: $REPO_DIR"
        cd "$REPO_DIR"
    fi
elif [ -n "$REPO_DIR" ] && [ -d "$REPO_DIR" ]; then
    echo "📂 Switching to session repository: $REPO_DIR"
    cd "$REPO_DIR"
else
    echo "ERROR: Cannot find git repository '${REPO_DIR:-current directory}'. Please run sandbox-resume from inside the target git repository." >&2
    exit 1
fi

# Switch branch if requested
if [ -n "$TARGET_BRANCH" ]; then
    git checkout "$TARGET_BRANCH" 2>/dev/null || git checkout -b "$TARGET_BRANCH"
fi

echo "🔄 Resuming session '$SELECTED_SESSION' ($AGENT)..."

# --- Initialize on-demand worktree & environment ---
init_resume_environment "$SESSION_HOME" "$AGENT"

# --- Launch Container ---
case "$AGENT" in
    claude)
        SHARED_GCLOUD_DIR="$BASE_SANDBOX_DIR/shared_gcloud"
        CLAUDE_SETUP_PATH="$(cd "$SCRIPT_DIR/../share" && pwd)/claude-setup"
        TOOL_PODMAN_ARGS=(
            -e IS_SANDBOX=1
            -e CLI_TOOL_NAME="claude"
            -w /workspace
        )
        if [ -n "${CLAUDE_VERTEX_PROJECT_ID:-}" ]; then
            mkdir -p "$SHARED_GCLOUD_DIR"
            TOOL_PODMAN_ARGS+=(-v "$SHARED_GCLOUD_DIR":/root/.config/gcloud:z)
            echo "☁️ Shared gcloud auth cache: $SHARED_GCLOUD_DIR -> /root/.config/gcloud"
        elif [ -n "${ANTHROPIC_API_KEY:-}" ] || [ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]; then
            ANTHROPIC_VARS=()
            while IFS= read -r var; do
                ANTHROPIC_VARS+=("$var")
                TOOL_PODMAN_ARGS+=(-e "$var")
            done < <(compgen -e | grep '^ANTHROPIC_' | sort)
            echo "🔑 Anthropic API auth: forwarding ${ANTHROPIC_VARS[*]}"
        else
            echo "⚠️ No Claude credentials: set CLAUDE_VERTEX_PROJECT_ID (Vertex AI) or ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN."
            echo "   Claude will ask you to log in, and that login is not kept after the session."
        fi

        if [ -f "$CLAUDE_SETUP_PATH" ]; then
            TOOL_PODMAN_ARGS+=(-v "$CLAUDE_SETUP_PATH":/usr/local/bin/claude-setup:ro,z)
        fi
        if [ -n "${CLAUDE_VERTEX_PROJECT_ID:-}" ]; then
            TOOL_PODMAN_ARGS+=(-e CLAUDE_VERTEX_PROJECT_ID="$CLAUDE_VERTEX_PROJECT_ID")
        fi

        if [ "${#PASSED_CMD[@]}" -gt 0 ]; then
            CLAUDE_INVOKE=("${PASSED_CMD[@]}")
        else
            CLAUDE_INVOKE=(claude --dangerously-skip-permissions --resume)
        fi

        run_agent_container "claude-dev-sandbox:latest" \
            "${TOOL_PODMAN_ARGS[@]}" \
            -- bash -c '
                if [ -n "$CLAUDE_VERTEX_PROJECT_ID" ]; then
                    echo "⚙️ Running Vertex AI setup..."
                    source /usr/local/bin/claude-setup "$CLAUDE_VERTEX_PROJECT_ID" || exit 1
                fi
                exec "$@"
            ' -- "${CLAUDE_INVOKE[@]}"
        ;;

    bob)
        TOOL_PODMAN_ARGS=(
            -e CLI_TOOL_NAME="bob"
        )
        seed_auth_from_host "$HOME/.bob/settings" "$SANDBOX_HOME/.bob/settings" auth-secrets.json

        if [ "${#PASSED_CMD[@]}" -gt 0 ]; then
            BOB_INVOKE=("${PASSED_CMD[@]}")
        else
            BOB_INVOKE=(bob chat --auto-approve --trust --resume latest)
        fi

        run_agent_container "bob-dev-sandbox:latest" "${TOOL_PODMAN_ARGS[@]}" -- "${BOB_INVOKE[@]}"
        ;;

    gemini)
        TOOL_PODMAN_ARGS=(
            -e CLI_TOOL_NAME="gemini"
            -e GEMINI_CLI_TRUST_WORKSPACE="true"
        )
        if [ -n "${GEMINI_API_KEY:-}" ]; then
            TOOL_PODMAN_ARGS+=(-e GEMINI_API_KEY)
        fi

        if [ "${#PASSED_CMD[@]}" -gt 0 ]; then
            GEMINI_INVOKE=("${PASSED_CMD[@]}")
        else
            GEMINI_INVOKE=(gemini --approval-mode=yolo --resume latest)
        fi

        run_agent_container "gemini-dev-sandbox:latest" \
            "${TOOL_PODMAN_ARGS[@]}" \
            -- "${GEMINI_INVOKE[@]}"
        ;;

    codex)
        TOOL_PODMAN_ARGS=(
            -e CLI_TOOL_NAME="codex"
        )
        seed_auth_from_host "$HOME/.codex" "$SANDBOX_HOME/.codex" auth.json
        # Trust the throwaway workspace (already there unless the session was unpacked)
        grep -qs '^\[projects."/workspace"\]' "$SANDBOX_HOME/.codex/config.toml" ||
            printf '\n[projects."/workspace"]\ntrust_level = "trusted"\n' >> "$SANDBOX_HOME/.codex/config.toml"

        if [ "${#PASSED_CMD[@]}" -gt 0 ]; then
            CODEX_INVOKE=("${PASSED_CMD[@]}")
        else
            CODEX_INVOKE=(codex --dangerously-bypass-approvals-and-sandbox resume --last)
        fi

        run_agent_container "codex-dev-sandbox:latest" \
            "${TOOL_PODMAN_ARGS[@]}" \
            -- "${CODEX_INVOKE[@]}"
        ;;

    *)
        echo "ERROR: Unknown agent '$AGENT'." >&2
        exit 1
        ;;
esac
