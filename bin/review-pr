#!/usr/bin/env bash

set -euo pipefail

# 1. Parse options and validate argument count
USAGE="Usage: $0 [--batch <batch-id>] [--non-interactive] <pr-number> <bob|gemini|claude|codex>"
BATCH_ID=""
NON_INTERACTIVE=false
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --batch)
            if [[ $# -lt 2 ]]; then
                echo "Error: --batch requires a value." >&2
                echo "$USAGE" >&2
                exit 1
            fi
            BATCH_ID="$2"
            shift 2
            ;;
        --batch=*)
            BATCH_ID="${1#--batch=}"
            shift
            ;;
        --non-interactive)
            NON_INTERACTIVE=true
            shift
            ;;
        -*)
            echo "Error: Unknown option '$1'." >&2
            echo "$USAGE" >&2
            exit 1
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

if [[ ${#POSITIONAL[@]} -ne 2 ]]; then
    echo "Error: Exactly 2 arguments required: <pr-number> and <reviewer>." >&2
    echo "$USAGE" >&2
    exit 1
fi

PR_NUM="${POSITIONAL[0]}"
REVIEWER="${POSITIONAL[1]}"

# 2. Validate PR number is numeric
if ! [[ "$PR_NUM" =~ ^[0-9]+$ ]]; then
    echo "Error: PR number must be a positive integer. Received: '$PR_NUM'" >&2
    exit 1
fi

# 3. Validate reviewer value
case "$REVIEWER" in
    bob|gemini|claude|codex)
        ;;
    *)
        echo "Error: Invalid reviewer '$REVIEWER'. Allowed options: bob, gemini, claude, codex" >&2
        exit 1
        ;;
esac

# Validate optional batch identifier (kept simple so it is safe as a Logseq property value)
if [[ -n "$BATCH_ID" && ! "$BATCH_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: Invalid batch-id '$BATCH_ID'. Allowed characters: letters, digits, '.', '_', '-'" >&2
    exit 1
fi

# An unattended Bob run uses 'bob run', which only works with an API key
if [[ "$NON_INTERACTIVE" == true && "$REVIEWER" == bob && -z "${BOB_API_KEY:-}" ]]; then
    echo "Error: --non-interactive with bob needs BOB_API_KEY set (the saved bob login is not used by 'bob run')." >&2
    exit 1
fi

# 4. Check for gh CLI availability
if ! command -v gh &>/dev/null; then
    echo "Error: GitHub CLI ('gh') is not installed or not in PATH." >&2
    exit 1
fi

# 5. Check PR existence
echo "Checking existence of PR #${PR_NUM}..."
if ! BRANCH="$(gh pr view "$PR_NUM" --json headRefName -q .headRefName 2>/dev/null)" || [[ -z "$BRANCH" ]]; then
    echo "Error: Pull Request #${PR_NUM} was not found or is inaccessible." >&2
    exit 1
fi

# 6. Checkout PR branch. The starting branch/commit is remembered and handed to the
# sandbox launcher, which switches back to it once the review worktree is created.
ORIGINAL_REF="$(git symbolic-ref --short -q HEAD || git rev-parse HEAD)"

echo "Checking out PR #${PR_NUM}..."
if ! CHECKOUT_OUTPUT="$(gh pr checkout "$PR_NUM" 2>&1)"; then
    echo "$CHECKOUT_OUTPUT" >&2
    if echo "$CHECKOUT_OUTPUT" | grep -qiE 'fast[- ]?forward'; then
        if [[ "$NON_INTERACTIVE" == true ]]; then
            echo "Error: Branch '${BRANCH}' could not be fast-forwarded. Not deleting it in --non-interactive mode; fix or delete it and retry." >&2
            exit 1
        fi
        read -r -p "Branch '${BRANCH}' could not be fast-forwarded. Delete branch and check it out again? [y/N] " CONFIRM
        if [[ "$CONFIRM" =~ ^[yY]([eE][sS])?$ ]]; then
            echo "Deleting branch '${BRANCH}' and checking it out again..."
            CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || true)"
            if [[ "$CURRENT_BRANCH" == "$BRANCH" ]]; then
                git checkout -q --detach HEAD
            fi
            git branch -D "$BRANCH"
            gh pr checkout "$PR_NUM"
        else
            echo "Checkout aborted." >&2
            exit 1
        fi
    else
        exit 1
    fi
else
    [[ -n "$CHECKOUT_OUTPUT" ]] && echo "$CHECKOUT_OUTPUT"
fi

# 7. Check if reviewer sandbox executable exists
EXECUTABLE="${REVIEWER}-sandbox"
if ! command -v "$EXECUTABLE" &>/dev/null; then
    echo "Error: Executable '$EXECUTABLE' not found in PATH." >&2
    exit 1
fi

# 8. Run the reviewer command
PROMPT="Please review the changes in pull request #${PR_NUM} on the current branch. You can query information from PR #${PR_NUM} itself. Note the current branch is a worktree of this PR, so you don't need to fetch from git. Also check existing comments on the PR to confirm if they are correct or not and if additional information should be provided there."
if [[ -n "$BATCH_ID" ]]; then
    PROMPT+=" This review is part of the review batch '${BATCH_ID}'. In the Logseq log you write, record this batch identifier as a property on the top-level review block (batch:: ${BATCH_ID}) so reviews in the same batch can be found and compared together."
fi
echo "Executing: $EXECUTABLE \"$PROMPT\""
if [[ "$NON_INTERACTIVE" == true ]]; then
    # Headless run, no tty, no merge-back prompt (see SANDBOX_NON_INTERACTIVE in common-sandbox.sh)
    SANDBOX_NON_INTERACTIVE=1 SANDBOX_RESTORE_REF="$ORIGINAL_REF" "$EXECUTABLE" "$PROMPT"
else
    SANDBOX_RESTORE_REF="$ORIGINAL_REF" "$EXECUTABLE" "$PROMPT"
fi
